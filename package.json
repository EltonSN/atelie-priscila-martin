{
  "name": "atelier-priscila-martin",
  "version": "0.1.0",
  "private": true,
  "description": "Landing page do Atelier Priscila Martin — cortinados a medida, Portugal",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "clean:images": "node -e \"require('node:fs').rmSync('.next/cache/images',{recursive:true,force:true})\"",
    "build:fresh": "pnpm clean:images && pnpm build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.4.2"
}
